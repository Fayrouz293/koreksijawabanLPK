{
  "name": "koreksi-tryout-lpk-josg",
  "version": "1.0.0",
  "description": "Koreksi try-out bahasa Jepang (OMR lokal) untuk LPK Jaroe Oshin Gakuin",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "npm run build && node --env-file-if-exists=.env server/index.js",
    "test:akurasi": "node tests/accuracy/run.mjs 3 --gaya=normal && node tests/accuracy/run.mjs 3 --gaya=sulit && node tests/accuracy/names.mjs",
    "test:e2e": "node tests/e2e/run.mjs && node tests/e2e/scan.mjs",
    "kalibrasi": "node scripts/calibrate.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fayrouz293/koreksijawabanLPK.git"
  },
  "bugs": {
    "url": "https://github.com/Fayrouz293/koreksijawabanLPK/issues"
  },
  "homepage": "https://github.com/Fayrouz293/koreksijawabanLPK#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "jpeg-js": "^0.4.4",
    "vite": "^8.3.5"
  },
  "type": "module"
}
